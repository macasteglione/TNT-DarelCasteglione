{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "dockerfilePath": "DonarYa/backend/Dockerfile",
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/api/merenderos",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
